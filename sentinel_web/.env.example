IVSEC_HOST=192.168.68.203
IVSEC_USERNAME=
IVSEC_PASSWORD=
IVSEC_HISTORY_DAYS=7
# 0 = confirmed main stream. 1/2 = sub/mobile, not yet verified.
IVSEC_STREAM_INDEX=0
# Uses the recorder's low-bandwidth mobile stream for dashboard snapshots.
IVSEC_SNAPSHOT_STREAM_INDEX=2
FFMPEG_PATH=ffmpeg

# Animal detection. AUTO prefers an Intel accelerator and falls back to CPU.
FRIGATE_OPENVINO_DEVICE=AUTO
# Optional normalized polygon masks for scene-specific false-positive regions.
# Example syntax: FRIGATE_OBJECT_MASK_CH05=0.70,0.10,1.00,0.10,1.00,0.80,0.70,0.80
# FRIGATE_OBJECT_MASK_CH01=
# FRIGATE_OBJECT_MASK_CH03=
# FRIGATE_OBJECT_MASK_CH04=
# FRIGATE_OBJECT_MASK_CH05=
# FRIGATE_OBJECT_MASK_CH06=
# FRIGATE_OBJECT_MASK_CH08=
# Address your phone uses to reach Sentinel. Included in Home Assistant alerts.
SENTINEL_PUBLIC_URL=http://192.168.68.100:3000
# Home Assistant webhook URL. Leave empty during shadow-mode evaluation.
HA_ANIMAL_WEBHOOK_URL=

# Only needed for iPhone access to npm run dev; use the Linux host LAN IP.
# DEV_ALLOWED_ORIGINS=192.168.68.100
